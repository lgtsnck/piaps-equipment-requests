@startuml
' ПиАПС. Обработка заявки на приобретение оборудования.
' Сквозная UML Activity-модель для единого учебного проекта.

title Обработка заявки на приобретение оборудования
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultTextAlignment center
skinparam activityBorderColor #364A63
skinparam activityBackgroundColor #F0F5FA
skinparam activityDiamondBackgroundColor #FFF4DA
skinparam activityDiamondBorderColor #B67C2D
skinparam ArrowColor #475569

|Заявитель|
start
:Заполнить заявку:\nоборудование, количество,\nобоснование;

|Система|
while (Есть ошибки заполнения?) is (да)
  :Показать ошибки;
  |Заявитель|
  :Исправить данные заявки;
  |Система|
endwhile (нет)
:Зарегистрировать заявку\n«Создана»;

|Заявитель|
:Отправить заявку\nна согласование;
|Система|
:Установить состояние\n«На согласовании»;

|Руководитель МТС|
:Рассмотреть заявку;
while (Нужно уточнение?) is (да)
  :Указать причину возврата;
  |Система|
  :Установить состояние\n«На уточнении»;
  |Заявитель|
  :Исправить / дополнить заявку;
  :Повторно отправить\nна согласование;
  |Система|
  :Установить состояние\n«На согласовании»;
  |Руководитель МТС|
  :Повторно рассмотреть заявку;
endwhile (нет)

if (Согласовать заявку?) then (да)
  |Система|
  :Установить состояние\n«Согласована»;
else (нет)
  |Руководитель МТС|
  :Указать причину отклонения;
  |Система|
  :Установить состояние\n«Отклонена»;
  stop
endif

|Руководитель МТС|
:Назначить специалиста МТС;
|Система|
:Установить состояние\n«Назначена»;

|Специалист МТС|
:Приступить к обработке;
|Система|
:Установить состояние\n«В работе»;
|Специалист МТС|
:Организовать приобретение\n(вне системы);
:Зафиксировать результат\nвыполнения заявки;
|Система|
:Установить состояние\n«Закрыта»;
stop

@enduml
