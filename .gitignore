# Python virtual environments
.venv/
venv/
env/

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test coverage and build artifacts
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# JetBrains local IDE settings
.idea/

# Local databases (not source code or database schema)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local configuration and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.bak

# Operating system files
Thumbs.db
.DS_Store
